{
    "_id": "pL5wD1sKx8Nr4uYe",
    "img": "icons/magic/defensive/shield-barrier-deflect-teal.webp",
    "name": "Effect: Spell Protection Protocol",
    "system": {
        "description": {
            "value": "<p>Granted by @UUID[Compendium.sf2e.feats.Item.Spell Protection Protocol]</p>\n<p>You gain temporary Hit Points equal to double the chosen spell rank for 1 minute. If the spell dealt energy damage, you also gain resistance to the chosen energy type equal to that rank. Choose None when the spell dealt no energy damage.</p>\n<p>If this shield should protect your tech minion instead of you, drag this effect onto that minion. The resistance is meant to end when the temporary Hit Points are gone; this effect lasts the full minute.</p>"
        },
        "duration": {
            "expiry": "turn-start",
            "sustained": false,
            "unit": "minutes",
            "value": 1
        },
        "fromSpell": false,
        "level": {
            "value": 4
        },
        "publication": {
